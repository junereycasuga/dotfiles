{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm -rf *": "deny",
      "sudo rm *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/Library/Group Containers/2BUA8C4S2C.com.1password/**": "deny"
    }
  },
  // MCP configuration
  // Run `opencode mcp auth {mcp-name}` to authenticate
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/sse",
      "enabled": true,
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true,
    }
  },
  "plugin": [
    "opencode-anthropic-auth@0.0.13"
  ]
}
