{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "psql *": "ask",
      "pgcli *": "ask",
      "mysql *": "ask",
      "sqlite3 *": "ask",
      "prisma migrate *": "ask",
      "prisma db *": "ask",
      "drizzle-kit *": "ask",
      "sequelize *": "ask",
      "typeorm *": "ask",
      "atlas *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/Library/Group Containers/2BUA8C4S2C.com.1password/**": "deny"
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "/Users/junerey/.local/share/mise/installs/python/3.12.9/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/sse",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    },
    "paper": {
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp",
      "enabled": true
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js"
  ]
}
